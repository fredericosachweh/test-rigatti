PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/modena_spo
JWT_SECRET=super-secret-change-me

# Escolha o provedor: "openai" ou "anthropic"
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CLIENT_URL=http://localhost:5173

# Diretório de uploads de imagens (relativo à raiz do apps/api)
# Usado apenas se o Cloudinary NÃO estiver configurado (fallback local)
UPLOADS_DIR=uploads

# Cloudinary — armazenamento persistente das fotos (produção).
# Se as 3 estiverem preenchidas, os uploads vão para o Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

